{
  "name": "mcp-server-starter",
  "version": "1.0.0",
  "description": "Minimal, production-minded MCP server starter in TypeScript: stateless Streamable HTTP + stdio, one example tool, tests, and a preflight checker for deployed MCP servers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-server-starter": "dist/stdio.js"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/node.js",
    "start:stdio": "node dist/stdio.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "preflight": "tsx scripts/preflight.ts",
    "inspector": "npx @modelcontextprotocol/inspector",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "typescript",
    "claude",
    "cursor",
    "streamable-http",
    "cloudflare-workers"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^4.1.12",
    "wrangler": "^4.86.0"
  }
}
